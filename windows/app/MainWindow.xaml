<Window
    x:Class="OpenReceiver.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenReceiver"
    Title="OpenReceiver"
    Width="1280" Height="720">

    <Grid Background="Black">
        <!-- Background Gradient Mock -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF2B1C2A" Offset="0.0" />
                <GradientStop Color="#FF111111" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Margin="60">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Artwork -->
                <ColumnDefinition Width="400"/>  <!-- Metadata/Controls -->
                <ColumnDefinition Width="*"/>    <!-- Lyrics -->
            </Grid.ColumnDefinitions>

            <!-- Album Artwork Mock -->
            <Border Grid.Column="0" Width="400" Height="400" CornerRadius="12" Background="#333333" 
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    BoxShadow="0, 20, 40, 0, #80000000">
                <TextBlock Text="🎵" FontSize="120" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#888888"/>
            </Border>

            <!-- Metadata & Controls -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="80,0,0,0">
                <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" FontSize="48" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{x:Bind ViewModel.Artist, Mode=OneWay}" FontSize="24" Foreground="#BBBBBB" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{x:Bind ViewModel.Album, Mode=OneWay}" FontSize="20" Foreground="#888888" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>

                <!-- Timeline -->
                <Grid Margin="0,40,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="0:45" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Slider Grid.Column="1" Value="{x:Bind ViewModel.Position, Mode=OneWay}" Maximum="{x:Bind ViewModel.Duration, Mode=OneWay}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="-3:05" Foreground="#888888" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </Grid>

                <!-- Controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,32,0,0">
                    <Button Content="⏮" FontSize="24" Background="Transparent" Foreground="White" BorderThickness="0" Margin="0,0,24,0"/>
                    <Button Content="⏸" FontSize="36" Background="Transparent" Foreground="White" BorderThickness="0" Margin="0,0,24,0"/>
                    <Button Content="⏭" FontSize="24" Background="Transparent" Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </StackPanel>

            <!-- Lyrics Area -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="80,0,0,0" 
                        Visibility="{x:Bind ViewModel.IsLyricsAvailable, Mode=OneWay}">
                <!-- Quiet surrounding line (previous) -->
                <TextBlock Text="{x:Bind ViewModel.PreviousLyric, Mode=OneWay}" 
                           FontSize="32" Foreground="#444444" 
                           FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,24"/>
                           
                <!-- Prominent active line -->
                <TextBlock Text="{x:Bind ViewModel.CurrentLyric, Mode=OneWay}" 
                           FontSize="48" Foreground="White" 
                           FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,24"/>
                           
                <!-- Quiet surrounding line (next) -->
                <TextBlock Text="{x:Bind ViewModel.NextLyric, Mode=OneWay}" 
                           FontSize="32" Foreground="#444444" 
                           FontWeight="SemiBold" TextWrapping="Wrap"/>
            </StackPanel>
            
            <!-- Lyrics Unavailable State -->
            <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Text="Lyrics unavailable" FontSize="24" Foreground="#444444"
                       Visibility="{x:Bind ViewModel.IsLyricsAvailable, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"/>
        </Grid>
    </Grid>
</Window>
