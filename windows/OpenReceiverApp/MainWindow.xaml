<Window
    x:Class="OpenReceiver.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenReceiver"
    Title="OpenReceiver">

    <Grid>
        <!-- Seamless Apple Music Gradient Background -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFB24902" Offset="0.0" />
                <GradientStop Color="#FF712900" Offset="0.6" />
                <GradientStop Color="#FF301200" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Custom Title Bar Area (Top edge seamlessness) -->
        <Grid x:Name="AppTitleBar" Height="40" VerticalAlignment="Top" Background="Transparent" Canvas.ZIndex="100"/>

        <!-- Main Content (Expanded to remove borders) -->
        <Grid Margin="120,40,120,40" ColumnSpacing="140">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4.5*"/> <!-- Left Side -->
                <ColumnDefinition Width="5.5*"/> <!-- Right Side -->
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Perfectly proportioned 400px fixed width layout -->
            <Viewbox Grid.Column="0" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Grid Width="420">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Authentic Album Artwork with actual Image loading -->
                    <Grid Grid.Row="0" Width="420" Height="420" CornerRadius="12" BorderBrush="#22FFFFFF" BorderThickness="1">
                        <Image Source="{x:Bind ViewModel.AlbumArt, Mode=OneWay}" Stretch="UniformToFill"/>
                    </Grid>

                    <!-- Metadata -->
                    <StackPanel Grid.Row="1" Margin="0,32,0,0">
                        <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" 
                                   FontSize="24" FontWeight="Bold" Foreground="White" 
                                   TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" FontFamily="Segoe UI Variable Display"/>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock Text="{x:Bind ViewModel.Artist, Mode=OneWay}" 
                                       FontSize="16" Foreground="White" Opacity="0.8"
                                       TextTrimming="CharacterEllipsis" FontWeight="Normal" FontFamily="Segoe UI Variable Display"/>
                        </StackPanel>
                        
                        <!-- Lossless Badge -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0" Opacity="0.8">
                            <FontIcon Glyph="&#xE995;" FontSize="11" Foreground="White" Margin="0,0,6,0"/>
                            <TextBlock Text="Lossless" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Timeline -->
                    <Grid Grid.Row="2" Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.PositionString, Mode=OneWay}" Foreground="White" Opacity="0.6" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        
                        <!-- Sleek timeline bar (Apple Music style) -->
                        <Grid Grid.Column="1" VerticalAlignment="Center" Height="3">
                            <Rectangle Fill="#33FFFFFF" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Stretch"/>
                            
                            <Rectangle Fill="White" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform ScaleX="{x:Bind ViewModel.ProgressScale, Mode=OneWay}" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Grid>
                        
                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.RemainingString, Mode=OneWay}" Foreground="White" Opacity="0.6" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>

                    <!-- Controls -->
                    <Grid Grid.Row="3" Margin="0,24,0,0">
                        <!-- Left controls (Volume, More) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Button Background="Transparent" BorderThickness="0" Margin="0,0,8,0" Opacity="0.7">
                                <FontIcon Glyph="&#xE995;" Foreground="White" FontSize="16"/>
                            </Button>
                            <Button Background="Transparent" BorderThickness="0" Opacity="0.7">
                                <FontIcon Glyph="&#xE712;" Foreground="White" FontSize="16"/>
                            </Button>
                        </StackPanel>
                        
                        <!-- Playback Controls (Center) - No circle, just clean icons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Background="Transparent" BorderThickness="0" Margin="0,0,24,0" Click="{x:Bind ViewModel.PreviousTrack}">
                                <FontIcon Glyph="&#xE892;" Foreground="White" FontSize="16"/>
                            </Button>
                            
                            <Button Background="Transparent" BorderThickness="0" Padding="12,4" Click="{x:Bind ViewModel.TogglePlayPause}">
                                <FontIcon Glyph="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}" Foreground="White" FontSize="28"/>
                            </Button>
                            
                            <Button Background="Transparent" BorderThickness="0" Margin="24,0,0,0" Click="{x:Bind ViewModel.NextTrack}">
                                <FontIcon Glyph="&#xE893;" Foreground="White" FontSize="16"/>
                            </Button>
                        </StackPanel>
                        
                        <!-- Lyrics Toggle (Right aligned with chat bubble icon) -->
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Background="#33FFFFFF" BorderThickness="0" CornerRadius="8" Padding="12,6" Click="{x:Bind ViewModel.ToggleLyrics}">
                            <FontIcon Glyph="&#xE8BD;" Foreground="White" FontSize="14" Opacity="0.9"/>
                        </Button>
                    </Grid>
                </Grid>
            </Viewbox>

            <!-- RIGHT COLUMN: Scrolling Lyrics -->
            <StackPanel x:Name="LyricsPanel" Grid.Column="1" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.LyricsVisibility, Mode=OneWay}" Margin="0,0,0,0">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="LyricsTranslate" Y="0" />
                </StackPanel.RenderTransform>
                
                <TextBlock Text="{x:Bind ViewModel.PreviousLyric, Mode=OneWay}" 
                           FontSize="28" Foreground="White" Opacity="0.4"
                           FontWeight="Medium" TextWrapping="Wrap" Margin="0,0,0,24" LineHeight="40" FontFamily="Segoe UI Variable Display"/>

                <!-- Prominent active line -->
                <TextBlock Text="{x:Bind ViewModel.CurrentLyric, Mode=OneWay}" 
                           FontSize="38" Foreground="White" 
                           FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,24" LineHeight="48" FontFamily="Segoe UI Variable Display"/>
                           
                <!-- Fading surrounding lines -->
                <TextBlock Text="{x:Bind ViewModel.NextLyric, Mode=OneWay}" 
                           FontSize="32" Foreground="White" Opacity="0.4"
                           FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,24" LineHeight="44" FontFamily="Segoe UI Variable Display"/>
                           
                <TextBlock Text="{x:Bind ViewModel.NextNextLyric, Mode=OneWay}" 
                           FontSize="32" Foreground="White" Opacity="0.2"
                           FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,24" LineHeight="44" FontFamily="Segoe UI Variable Display"/>
                           
                <TextBlock Text="" 
                           FontSize="32" Foreground="White" Opacity="0.1"
                           FontWeight="Bold" TextWrapping="Wrap" LineHeight="44" FontFamily="Segoe UI Variable Display"/>
            </StackPanel>
            
            <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Text="Lyrics unavailable" FontSize="24" Foreground="#444444"
                       Visibility="{x:Bind ViewModel.NoLyricsVisibility, Mode=OneWay}"/>
        </Grid>
    </Grid>
</Window>
