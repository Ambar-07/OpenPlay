<Window
    x:Class="OpenReceiver.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenReceiver"
    Title="OpenReceiver">

    <Grid>
        <!-- The Adaptive, Fluid Flowing Album Art Background -->
        <Grid>
            <!-- Background base -->
            <Image Source="{x:Bind ViewModel.AlbumArt, Mode=OneWay}" Stretch="UniformToFill" Opacity="0.5"/>
            
            <!-- Blob 1 -->
            <Image Source="{x:Bind ViewModel.AlbumArt, Mode=OneWay}" Stretch="UniformToFill" Width="800" Height="800" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0.9">
                <Image.RenderTransform>
                    <CompositeTransform x:Name="Blob1Transform" TranslateX="-100" TranslateY="-100" ScaleX="1.5" ScaleY="1.5" Rotation="0" />
                </Image.RenderTransform>
            </Image>
            
            <!-- Blob 2 -->
            <Image Source="{x:Bind ViewModel.AlbumArt, Mode=OneWay}" Stretch="UniformToFill" Width="1000" Height="1000" HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity="0.9">
                <Image.RenderTransform>
                    <CompositeTransform x:Name="Blob2Transform" TranslateX="100" TranslateY="100" ScaleX="2.0" ScaleY="2.0" Rotation="45"/>
                </Image.RenderTransform>
            </Image>
            
            <!-- Blob 3 -->
            <Image Source="{x:Bind ViewModel.AlbumArt, Mode=OneWay}" Stretch="UniformToFill" Width="900" Height="900" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9">
                <Image.RenderTransform>
                    <CompositeTransform x:Name="Blob3Transform" TranslateX="0" TranslateY="0" ScaleX="1.8" ScaleY="1.8" Rotation="90"/>
                </Image.RenderTransform>
            </Image>
            
            <!-- Heavy Blur Overlay to create the smooth fluid gradient look -->
            <Grid>
                <Grid.Background>
                    <AcrylicBrush TintColor="#FF080808" TintOpacity="0.4" FallbackColor="#FF0F0F0F" />
                </Grid.Background>
            </Grid>
        </Grid>

        <!-- Custom Title Bar Area (Top edge seamlessness) -->
        <Grid x:Name="AppTitleBar" Height="40" VerticalAlignment="Top" Background="Transparent" Canvas.ZIndex="100"/>

        <!-- Main Content (Expanded to remove borders) -->
        <Grid Margin="120,40,120,40" ColumnSpacing="140">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="AlbumColumn" Width="4.5*"/> <!-- Left Side -->
                <ColumnDefinition x:Name="LyricsColumn" Width="5.5*"/> <!-- Right Side -->
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Perfectly proportioned fixed width layout -->
            <Viewbox x:Name="AlbumViewbox" Grid.Column="0" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Grid Width="420">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Authentic Album Artwork with actual Image loading -->
                    <Grid Grid.Row="0" Width="360" Height="360" CornerRadius="12">
                        <Grid.Shadow>
                            <ThemeShadow/>
                        </Grid.Shadow>
                        <Image Source="{x:Bind ViewModel.AlbumArt, Mode=OneWay}" Stretch="UniformToFill" Margin="0"/>
                        <!-- Soft border overlay -->
                        <Border BorderBrush="#1AFFFFFF" BorderThickness="1" CornerRadius="12" />
                    </Grid>

                    <!-- Metadata -->
                    <StackPanel Grid.Row="1" Margin="0,32,0,0">
                        <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" 
                                   FontSize="22" FontWeight="Bold" Foreground="White" 
                                   TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" FontFamily="Segoe UI Variable Display"/>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock Text="{x:Bind ViewModel.Artist, Mode=OneWay}" 
                                       FontSize="14" Foreground="#B3FFFFFF"
                                       TextTrimming="CharacterEllipsis" FontWeight="Medium" FontFamily="Segoe UI Variable Display"/>
                    </StackPanel>

                    <!-- Timeline -->
                    <Grid Grid.Row="2" Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.PositionString, Mode=OneWay}" Foreground="White" Opacity="0.6" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        
                        <!-- Sleek timeline bar (Apple Music style) -->
                        <Grid Grid.Column="1" VerticalAlignment="Center" Height="20" Background="Transparent">
                            <!-- The bar -->
                            <Grid VerticalAlignment="Center" Height="3">
                                <Rectangle Fill="#33FFFFFF" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Stretch"/>
                            
                            <Rectangle Fill="White" RadiusX="1.5" RadiusY="1.5" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                                <Rectangle.RenderTransform>
                                    <ScaleTransform ScaleX="{x:Bind ViewModel.ProgressScale, Mode=OneWay}" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                            </Grid>
                        </Grid>
                        
                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.RemainingString, Mode=OneWay}" Foreground="White" Opacity="0.6" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>

                    <!-- Controls -->
                    <Grid Grid.Row="3" Margin="0,24,0,0">
                        <!-- Left controls (Volume Indicator) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Width="100">
                            <FontIcon Glyph="&#xE995;" Foreground="White" FontSize="16" Opacity="0.7" Margin="0,0,12,0"/>
                            <Grid VerticalAlignment="Center" Height="4" Width="70">
                                <Rectangle Fill="#33FFFFFF" RadiusX="2" RadiusY="2" HorizontalAlignment="Stretch"/>
                                
                                <Rectangle Fill="White" RadiusX="2" RadiusY="2" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform ScaleX="{x:Bind ViewModel.VolumeScale, Mode=OneWay}" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                        </StackPanel>
                        
                        <!-- Playback Controls (Center) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button Background="Transparent" BorderThickness="0" Margin="0,0,16,0" Click="{x:Bind ViewModel.PreviousTrack}" CornerRadius="20" Width="40" Height="40">
                                <FontIcon Glyph="&#xE892;" Foreground="White" FontSize="14"/>
                            </Button>
                            
                            <!-- Play/Pause Button with Circular Background -->
                            <Button Background="#E6FFFFFF" BorderThickness="0" Width="56" Height="56" CornerRadius="28" Click="{x:Bind ViewModel.TogglePlayPause}">
                                <FontIcon Glyph="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}" Foreground="Black" FontSize="22"/>
                            </Button>
                            
                            <Button Background="Transparent" BorderThickness="0" Margin="16,0,0,0" Click="{x:Bind ViewModel.NextTrack}" CornerRadius="20" Width="40" Height="40">
                                <FontIcon Glyph="&#xE893;" Foreground="White" FontSize="14"/>
                            </Button>
                        </StackPanel>
                        
                        <!-- Lyrics Toggle (Right aligned with chat bubble icon) -->
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Background="{x:Bind ViewModel.LyricsButtonBackground, Mode=OneWay}" BorderThickness="0" CornerRadius="8" Width="40" Height="32" Click="{x:Bind ViewModel.ToggleLyrics}">
                            <FontIcon Glyph="&#xE8BD;" Foreground="{x:Bind ViewModel.LyricsButtonForeground, Mode=OneWay}" FontSize="14" Opacity="{x:Bind ViewModel.LyricsButtonOpacity, Mode=OneWay}"/>
                        </Button>
                    </Grid>
                </Grid>
            </Viewbox>

            <!-- RIGHT COLUMN: Scrolling Lyrics -->
            <StackPanel x:Name="LyricsPanel" Grid.Column="1" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.LyricsVisibility, Mode=OneWay}" Margin="0,0,0,0">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="LyricsTranslate" Y="0" />
                </StackPanel.RenderTransform>
                
                <TextBlock Text="{x:Bind ViewModel.PreviousLyric, Mode=OneWay}" 
                           FontSize="20" Foreground="White" Opacity="0.3"
                           FontWeight="Medium" TextWrapping="Wrap" Margin="0,0,0,16" LineHeight="28" FontFamily="Segoe UI Variable Display"/>

                <!-- Prominent active line -->
                <TextBlock x:Name="CurrentLyricText" Text="{x:Bind ViewModel.CurrentLyric, Mode=OneWay}" 
                           FontSize="28" Foreground="White" Opacity="1.0"
                           FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,16" LineHeight="36" FontFamily="Segoe UI Variable Display" RenderTransformOrigin="0,0.5">
                    <TextBlock.RenderTransform>
                        <ScaleTransform x:Name="CurrentLyricScale" ScaleX="1.0" ScaleY="1.0"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
                           
                <!-- Fading surrounding lines -->
                <TextBlock Text="{x:Bind ViewModel.NextLyric, Mode=OneWay}" 
                           FontSize="24" Foreground="White" Opacity="0.3"
                           FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,16" LineHeight="32" FontFamily="Segoe UI Variable Display"/>
                           
                <TextBlock Text="{x:Bind ViewModel.NextNextLyric, Mode=OneWay}" 
                           FontSize="24" Foreground="White" Opacity="0.1"
                           FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,16" LineHeight="32" FontFamily="Segoe UI Variable Display"/>
                           
                <TextBlock Text="" 
                           FontSize="24" Foreground="White" Opacity="0.05"
                           FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="32" FontFamily="Segoe UI Variable Display"/>
            </StackPanel>
            
            <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Text="Lyrics unavailable" FontSize="24" Foreground="#444444"
                       Visibility="{x:Bind ViewModel.NoLyricsVisibility, Mode=OneWay}"/>
        </Grid>
    </Grid>
</Window>
